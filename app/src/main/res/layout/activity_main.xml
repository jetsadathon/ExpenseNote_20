<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#999999"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!--การ์ดหลัก -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#00A1E9"
            android:padding="20dp"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <!--หัวข้อแอป-->
            <TextView
                android:id="@+id/TfTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#6A6A6A"
                android:text="บันทึกค่าใช่จ่ายประจำวัน"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="4dp"
                android:gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="จดทุกบาทที่ใช้วันนี้ให้ครบเลยนะ"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:layout_marginTop="16dp" />
            <!--ช่องกรอกจำนวนเงิน-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="โปรดใส่จำนวนเงิน (เป็นบาท)"
                android:textSize="20sp"
                android:textColor="#FFFFFF" />

            <EditText
                android:id="@+id/TfAmount"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#000000"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="numberDecimal"
                android:hint="เช่น 100 หรือ 100.25"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:textColorHint="#FFFFFF"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"/>
            <!--ช่องคำอธิบาย-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="คำอธิบาย"
                android:textColor="#ffffff"
                android:textSize="20sp"/>

            <EditText
                android:id="@+id/TfNote"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#000000"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:inputType="text"
                android:hint="เช่น ข้าวกลางวัน,ค่าเดินทาง"
                android:textColorHint="#ffffff"
                android:textSize="20sp"
                android:textColor="#ffffff"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"/>

            <!--ปุ่มต่างๆ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">
                <Button
                    android:id="@+id/TfClear"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="เคลียร์"
                    android:textAllCaps="false"
                    android:backgroundTint="#000000"
                    android:textColor="#ffffff"
                    android:layout_marginEnd="8dp"/>
                <Button
                    android:id="@+id/TfAdd"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="เพิ่มรายการ"
                    android:textAllCaps="false"
                    android:backgroundTint="#0B0B0B"
                    android:textColor="#ffffff"
                    android:layout_marginEnd="8dp"/>

            </LinearLayout>
            <!--เส้นคั่นเล็กๆ-->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#ffffff"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"/>
            <!--แสดงผล-->
            <TextView
                android:id="@+id/TfLastItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="รายการล่าสุด: -"
                android:textColor="#ffffff"
                android:textSize="20sp"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/TfTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ยอดรวมวันนี้: 0.00 บาท"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
